diff --git a/node_modules/react-native-enriched/ios/styles/OrderedListStyle.mm b/node_modules/react-native-enriched/ios/styles/OrderedListStyle.mm
index 933b57e..4ca5ba9 100644
--- a/node_modules/react-native-enriched/ios/styles/OrderedListStyle.mm
+++ b/node_modules/react-native-enriched/ios/styles/OrderedListStyle.mm
@@ -198,6 +198,30 @@ - (BOOL)handleBackspaceInRange:(NSRange)range replacementText:(NSString *)text {
   return NO;
 }
 
+- (BOOL)handleNewlineOnEmptyItemInRange:(NSRange)range
+                        replacementText:(NSString *)text {
+  // Enter on an empty list item ends the list instead of adding another item
+  if (![text isEqualToString:@"\n"] || range.length > 0) {
+    return NO;
+  }
+  NSString *string = _input->textView.textStorage.string;
+  NSRange paragraphRange = [string paragraphRangeForRange:range];
+  if (paragraphRange.length == 0 || ![self detectStyle:paragraphRange]) {
+    return NO;
+  }
+  // an empty item only holds zero width spaces and its trailing newline
+  for (NSUInteger i = paragraphRange.location; i < NSMaxRange(paragraphRange);
+       i++) {
+    unichar character = [string characterAtIndex:i];
+    if (character != 0x200B &&
+        ![[NSCharacterSet newlineCharacterSet] characterIsMember:character]) {
+      return NO;
+    }
+  }
+  [self removeAttributes:paragraphRange];
+  return YES;
+}
